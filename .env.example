# Copy to .env.local for your machine:  cp .env.example .env.local
# .env.local is never committed. Real secrets for servers live on the server, never in this repository.
# Change every "change-me" value. Docs: docs/secrets.md

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-32-or-more-random-characters

# PostgreSQL (docker compose)
POSTGRES_USER=h2india
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=h2india
POSTGRES_PORT=5432
DATABASE_URL=postgresql://h2india:change-me-postgres@localhost:5432/h2india

# Redis (queues and timers)
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
REDIS_URL=redis://:change-me-redis@localhost:6379

# Meilisearch (search)
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700

# File storage (S3-compatible; MinIO locally)
S3_ACCESS_KEY=h2india
S3_SECRET_KEY=change-me-minio
S3_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_PRIVATE=h2india-private
S3_BUCKET_PUBLIC=h2india-public

# Email (Mailpit locally; the real provider is decision M6)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="H2 India <no-reply@h2india.local>"

# Feature flags (safe defaults from docs/decisions.md). "true" or "false".
FLAG_TRANSACTIONS=false
FLAG_PAY_LATER=false
FLAG_LETTER_OF_CREDIT=false
FLAG_COMING_SOON=false
FLAG_MAINTENANCE=false
