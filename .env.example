# Copy to .env.local for your machine:  cp .env.example .env.local
# .env.local is never committed. Real secrets for servers live on the server, never in this repository.
# Change every "change-me" value. Docs: docs/secrets.md

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Analytics script (M10, not chosen). Loaded only after cookie consent and never for operators. Leave empty.
NEXT_PUBLIC_ANALYTICS_SRC=
# 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-32-or-more-random-characters
# Google sign-in: leave empty until the Google Cloud credentials exist (founder task, step 3.2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Header with the visitor's IP. Locally and in CI: x-forwarded-for. On the server: the proxy's header.
AUTH_IP_HEADER=x-forwarded-for

# PostgreSQL (docker compose)
POSTGRES_USER=h2india
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=h2india
POSTGRES_PORT=5432
DATABASE_URL=postgresql://h2india:change-me-postgres@localhost:5432/h2india
# Integration tests rebuild this database on every run. It must end in _test.
TEST_DATABASE_URL=postgresql://h2india:change-me-postgres@localhost:5432/h2india_test

# Redis (queues and timers)
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
REDIS_URL=redis://:change-me-redis@localhost:6379

# Meilisearch (search)
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700

# File storage (S3-compatible; MinIO locally)
S3_ACCESS_KEY=h2india
S3_SECRET_KEY=change-me-minio
S3_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET_PRIVATE=h2india-private
S3_BUCKET_PUBLIC=h2india-public

# Email (Mailpit locally; the real provider is decision M6)
SMTP_HOST=localhost
SMTP_PORT=1025
# Provider login, when M6 is decided. Mailpit needs none.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="H2 India <no-reply@h2india.local>"
EMAIL_FROM_SECURITY="H2 India <security@h2india.local>"
# Support requests go here until the admin queue exists (decision A16)
SUPPORT_EMAIL=support@h2india.local

# Feature flags (safe defaults from docs/decisions.md). "true" or "false".
FLAG_TRANSACTIONS=false
FLAG_PAY_LATER=false
FLAG_LETTER_OF_CREDIT=false
FLAG_COMING_SOON=false
FLAG_MAINTENANCE=false
# /dev pages (design tokens, component gallery) are always on with `pnpm dev`; set true only on staging.
FLAG_DEV_PAGES=false
# Sample content (F9, A37): true on your machine and on staging to see the design's sample data; never in production.
FLAG_SAMPLE_CONTENT=false
# Lets search engines index the site (step 5.10). Switch on at Launch 1 only.
FLAG_SEARCH_INDEXING=false
# Uploads land here until the worker has scanned them (step 3.7)
S3_BUCKET_QUARANTINE=h2india-quarantine
# Public images base URL (a CDN in production); empty = the public bucket on S3_ENDPOINT
S3_PUBLIC_URL=
# Virus scan (ClamAV daemon; docker compose runs it locally)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Bot challenge on public forms (step 5.9; provider not chosen). Leave empty: honeypot, timing and rate limits apply.
BOT_CHALLENGE_SECRET=
BOT_CHALLENGE_VERIFY_URL=

# Payment partner (step 10.4, A176). "sim" is the simulated partner; a production build refuses it unless
# PAYMENT_SIM_ALLOWED=true (staging only, never live).
PAYMENT_PARTNER=sim
PAYMENT_SIM_ALLOWED=false
