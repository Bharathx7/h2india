# Step 13.3: nginx access and error logs kept 200 days (over the 180 CERT-In asks). Copy to /etc/logrotate.d/nginx
# on the server, replacing the distribution's file.
/var/log/nginx/*.log {
    daily
    rotate 200
    missingok
    notifempty
    compress
    delaycompress
    dateext
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
