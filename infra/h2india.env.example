# Production settings for infra/compose.prod.yml (step 1.7). Copy to /srv/h2india/h2india.env on the server,
# replace every change-me with a new random value (openssl rand -hex 32), then: chmod 600 h2india.env
# Never commit the real file. Names and meanings: docs/secrets.md and packages/config/src/env.ts.

# Image built by .github/workflows/image.yml (one tag per commit; roll back by setting the previous tag).
IMAGE=ghcr.io/bharathx7/h2india:change-me-commit

# The two domains (M1). APP_URL is set per service from these in compose.prod.yml.
PUBLIC_URL=https://h2india.deecodes.io
ADMIN_URL=https://adminh2india.deecodes.io
NEXT_PUBLIC_APP_URL=https://h2india.deecodes.io
NODE_ENV=production

# Shared by both web instances and the worker: sessions, codes and the worker's internal key.
AUTH_SECRET=change-me
# nginx overwrites X-Real-IP with the visitor's address; only nginx can reach the apps.
AUTH_IP_HEADER=x-real-ip
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

POSTGRES_USER=h2india
POSTGRES_PASSWORD=change-me
POSTGRES_DB=h2india
DATABASE_URL=postgresql://h2india:change-me@postgres:5432/h2india

REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379

MEILI_MASTER_KEY=change-me
MEILI_HOST=http://meilisearch:7700

# Storage is served from the public domain under the bucket names (two domains only; infra/nginx/h2india.conf).
# Browsers and the apps use the same address. Bucket names here must match the nginx locations.
S3_ENDPOINT=https://h2india.deecodes.io
S3_REGION=ap-south-1
S3_ACCESS_KEY=h2india
S3_SECRET_KEY=change-me
S3_BUCKET_PRIVATE=h2india-private
S3_BUCKET_PUBLIC=h2india-public
S3_BUCKET_QUARANTINE=h2india-quarantine
S3_PUBLIC_URL=https://h2india.deecodes.io/h2india-public

CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Until M6: caught by the mailpit service, never delivered.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=H2 India <hello@h2india.deecodes.io>
EMAIL_FROM_SECURITY=H2 India <security@h2india.deecodes.io>
SUPPORT_EMAIL=support@h2india.deecodes.io

# Flags. transactions stays off (Batch 6 on hold); sample content off in production; indexing off until Launch 1.
FLAG_TRANSACTIONS=false
FLAG_SAMPLE_CONTENT=false
FLAG_SEARCH_INDEXING=false
FLAG_COMING_SOON=false
FLAG_MAINTENANCE=false
FLAG_DEV_PAGES=false
