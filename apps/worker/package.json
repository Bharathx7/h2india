{
  "name": "@h2india/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --packages=external --alias:@h2india/core=../../packages/core/src --alias:@h2india/config=../../packages/config/src/index.ts --alias:@h2india/db=../../packages/db/src/index.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@h2india/config": "workspace:*",
    "@h2india/core": "workspace:*",
    "bullmq": "6.7.4",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
